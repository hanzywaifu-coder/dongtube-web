# Salin ke .env lalu isi nilainya. Jangan commit berkas .env yang asli.

# Port HTTP internal (nginx memproxy ke port ini)
PORT=3002

# Kunci acak untuk cookie sesi. Ganti dengan: openssl rand -hex 32
SESSION_SECRET=

# Nama situs di judul halaman dan footer
SITE_NAME=Dongtube OTP

# Dongtube Payment (https://payment.dongtube.cyou): katalog layanan, invoice
# QRIS, dan database DongtubeDB diakses lewat origin yang dikodekan di
# lib/pay2.js, dan database dipakai lewat endpoint /db/api/query di origin
# yang sama. Base URL tidak diatur lewat .env.
PAY2_API_KEY=

# Markup global dalam persen untuk semua user (admin bisa ubah dari panel)
DEFAULT_MARKUP_PERCENT=30

# Nominal minimum invoice isi saldo
MIN_DEPOSIT=10000

# Kode negara default di katalog
DEFAULT_COUNTRY=7

# Akun admin. Dibuat otomatis saat boot pertama.
# Bila ADMIN_PASSWORD kosong, password sementara saat boot pertama: admin123
# Nilai yang diubah di berkas ini otomatis ditekan ulang ke database saat restart.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
