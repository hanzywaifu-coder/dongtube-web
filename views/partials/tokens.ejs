<script>
// Pembaca JSON yang aman untuk semua fetch di halaman.
//
// Awalnya setiap form memakai response.json() langsung. Kalau sesi sudah
// habis, middleware isAuth membalas 302 ke /login dan fetch otomatis
// mengikuti redirect itu, sehingga yang diterima adalah halaman HTML.
// Akibatnya pengguna hanya melihat "Unexpected token '<'" yang tidak
// berguna dan tidak tahu harus masuk ulang.
window.apiJson = async function (response) {
  if (response && response.redirected) {
    let path = '';
    try { path = new URL(response.url).pathname; } catch (e) { /* abaikan */ }
    if (path === '/login' || path === '/logout') {
      throw new Error('Sesi Anda sudah berakhir. Silakan masuk ulang lalu coba lagi.');
    }
  }
  const type = (response.headers && response.headers.get('content-type')) || '';
  const text = await response.text();
  if (!text) throw new Error('Server tidak mengirim balasan. Silakan coba lagi.');
  try {
    return JSON.parse(text);
  } catch (e) {
    if (type.indexOf('text/html') !== -1 || /^\s*<(!doctype|html)/i.test(text)) {
      throw new Error('Server membalas halaman web, bukan data. Sesi Anda mungkin sudah berakhir. Silakan masuk ulang.');
    }
    throw new Error('Respons server tidak dapat dibaca. Silakan coba lagi.');
  }
};
</script>
