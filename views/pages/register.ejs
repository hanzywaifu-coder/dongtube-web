<%- include('../partials/header', { title: 'Daftar Akun' })%>

<div class="min-h-[78vh] flex flex-col items-center justify-center px-6 py-10 relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
    <div class="absolute -top-10 left-1/4 w-72 h-72 rounded-full bg-slate-300/35 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-72 h-72 rounded-full bg-slate-200/45 blur-3xl"></div>
  </div>
  <div class="reveal w-full max-w-md rounded-[2.25rem] shadow-soft-lg relative z-10">
    <div class="rounded-[2.25rem] bg-white px-7 py-9 md:px-9">

      <div class="text-center mb-8">
        <% if (settings.logoUrl) {%>
          <img src="<%= settings.logoUrl%>" alt="Logo" class="h-16 w-auto max-w-[220px] object-contain mx-auto mb-5">
        <% } else {%>
          <img src="/img/logo.jpg" alt="Logo" width="64" height="64" class="w-16 h-16 rounded-[20px] object-cover mx-auto mb-5 shadow-soft-lg">
        <% }%>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Buat Akun Baru</h1>
        <p class="text-[13px] font-medium text-slate-400 mt-1.5">Daftar untuk mulai menggunakan layanan kami</p>
      </div>

      <% if (typeof error !== 'undefined' && error) {%>
        <div class="w-full bg-rose-50 border border-rose-100 text-rose-600 px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3">
          <div class="w-8 h-8 rounded-[12px] bg-rose-100 flex items-center justify-center shrink-0">
            <i class="fas fa-exclamation-circle text-xs"></i>
          </div>
          <p><%= error%></p>
        </div>
      <% }%>

      <form method="POST" action="/register" class="w-full flex flex-col gap-3.5" autocomplete="off">

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2 px-1">Username</label>
          <div class="flex items-center bg-slate-50/80 border border-white rounded-[16px] p-1.5 transition-all duration-300 focus-within:border-finance-blue focus-within:ring-2 focus-within:ring-slate-200 focus-within:bg-white">
            <div class="pl-3 text-slate-400 flex items-center">
              <i class="fas fa-user text-xs"></i>
            </div>
            <input id="usernameInput" name="username" type="text" placeholder="Masukkan username" aria-label="Username"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full placeholder:text-xs placeholder:font-medium placeholder:text-slate-400"
                   maxlength="15" minlength="4" pattern="[a-z0-9]+" title="Username 4-15 karakter, hanya huruf kecil dan angka" required>
          </div>
          <div id="usernameStatus" class="mt-1.5 text-[10px] font-semibold min-h-[16px] px-1"></div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2 px-1">Alamat Email</label>
          <div class="flex items-center bg-slate-50/80 border border-white rounded-[16px] p-1.5 transition-all duration-300 focus-within:border-finance-blue focus-within:ring-2 focus-within:ring-slate-200 focus-within:bg-white">
            <div class="pl-3 text-slate-400 flex items-center">
              <i class="far fa-envelope text-xs"></i>
            </div>
            <input id="emailInput" name="email" type="email" placeholder="Masukkan alamat email" aria-label="Alamat email"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full placeholder:text-xs placeholder:font-medium placeholder:text-slate-400" required>
          </div>
          <div id="emailStatus" class="mt-1 text-[10px] font-semibold min-h-[16px] px-1"></div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-2 px-1">Password</label>
          <div class="flex items-center bg-slate-50/80 border border-white rounded-[16px] p-1.5 transition-all duration-300 focus-within:border-finance-blue focus-within:ring-2 focus-within:ring-slate-200 focus-within:bg-white">
            <div class="pl-3 text-slate-400 flex items-center">
              <i class="fas fa-lock text-xs"></i>
            </div>
            <input id="passwordInput" name="password" type="password" placeholder="••••••••" aria-label="Password"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full placeholder:text-xs placeholder:font-medium placeholder:text-slate-400" required>
            <button type="button" onclick="togglePassword()" aria-label="Tampilkan atau sembunyikan password" class="w-8 h-8 min-w-[44px] min-h-[44px] text-slate-400 hover:text-slate-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="toggleIcon" class="far fa-eye text-xs"></i>
            </button>
          </div>
        </div>

        <button type="submit" id="submitBtn" class="group bg-finance-blue text-white w-full py-4 rounded-[16px] text-sm font-bold shadow-soft-lg transition-all duration-700 ease-spring hover:-translate-y-0.5 active:scale-[0.99] flex items-center justify-center gap-2.5 mt-2 disabled:opacity-60 disabled:cursor-not-allowed">
          Daftar Sekarang <i class="fas fa-user-plus text-xs"></i>
        </button>
      </form>

      <p class="mt-7 text-center text-[13px] font-medium text-slate-400">
        Sudah punya akun?
        <a href="/login" class="text-finance-blue font-bold hover:underline transition-colors">Masuk di sini</a>
      </p>
    </div>
  </div>
</div>

<script>var __defProp=Object.defineProperty;var __name=(target,value)=>__defProp(target,"name",{value,configurable:true});function togglePassword(){const passwordInput=document.getElementById("passwordInput");const toggleIcon=document.getElementById("toggleIcon");if(passwordInput.type==="password"){passwordInput.type="text";toggleIcon.classList.replace("fa-eye","fa-eye-slash")}else{passwordInput.type="password";toggleIcon.classList.replace("fa-eye-slash","fa-eye")}}__name(togglePassword,"togglePassword");const usernameInput=document.getElementById("usernameInput");const emailInput=document.getElementById("emailInput");const usernameStatus=document.getElementById("usernameStatus");const emailStatus=document.getElementById("emailStatus");const submitBtn=document.getElementById("submitBtn");let usernameCheckTimer;let emailCheckTimer;async function checkAvailability(type,value,statusEl){if(!value){statusEl.innerHTML="";updateSubmitButton();return}if(type==="username"&&value.length<4){statusEl.innerHTML='<span class="text-slate-400">Minimal 4 karakter</span>';updateSubmitButton();return}try{const res=await fetch("/check-availability",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({type,value})});const data=await apiJson(res);if(data.available){statusEl.innerHTML=`<span class="text-emerald-600">\u2713 ${data.message}</span>`}else{statusEl.innerHTML=`<span class="text-rose-600">\u2717 ${data.message}</span>`}}catch(err){statusEl.innerHTML=`<span class="text-slate-400">\u26A0 Tidak dapat memeriksa</span>`}updateSubmitButton()}__name(checkAvailability,"checkAvailability");function updateSubmitButton(){const usernameText=usernameStatus.textContent;const emailText=emailStatus.textContent;const usernameInvalid=usernameText.includes("tidak valid")||usernameText.includes("sudah digunakan")||usernameText.includes("Tidak dapat")||usernameText.includes("Minimal 4 karakter");const emailInvalid=emailText.includes("tidak valid")||emailText.includes("sudah terdaftar")||emailText.includes("Tidak dapat");submitBtn.disabled=usernameInvalid||emailInvalid}__name(updateSubmitButton,"updateSubmitButton");usernameInput.addEventListener("input",function(){this.value=this.value.toLowerCase();clearTimeout(usernameCheckTimer);const val=this.value.trim();usernameCheckTimer=setTimeout(()=>checkAvailability("username",val,usernameStatus),400)});emailInput.addEventListener("input",function(){clearTimeout(emailCheckTimer);const val=this.value.trim();if(val&&/^\S+@\S+\.\S+$/.test(val)){emailCheckTimer=setTimeout(()=>checkAvailability("email",val,emailStatus),400)}else{emailStatus.innerHTML=val?'<span class="text-slate-400">Format email tidak valid</span>':"";updateSubmitButton()}});
</script>

<%- include('../partials/footer')%>