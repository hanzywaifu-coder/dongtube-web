<%- include('../partials/header', { title: 'Masuk' })%>

<div class="min-h-[78vh] flex flex-col items-center justify-center px-6 py-10 relative overflow-hidden">
  
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
    <div class="absolute -top-10 left-1/4 w-72 h-72 rounded-full bg-slate-300/35 blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-72 h-72 rounded-full bg-slate-200/45 blur-3xl"></div>
  </div>
  <div class="reveal w-full max-w-md rounded-[2.25rem] shadow-soft-lg relative z-10">
    <div class="rounded-[2.25rem] bg-white px-7 py-9 md:px-9">

      <div class="text-center mb-8">
        <% if (settings.logoUrl) {%>
          <img src="<%= settings.logoUrl%>" alt="Logo" class="h-16 w-auto max-w-[220px] object-contain mx-auto mb-5">
        <% } else {%>
          <img src="/img/logo.jpg" alt="Logo" width="64" height="64" class="w-16 h-16 rounded-[20px] object-cover mx-auto mb-5 shadow-soft-lg">
        <% }%>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Masuk ke Dashboard</h1>
        <p class="text-[13px] font-medium text-slate-600 mt-1.5">Masuk menggunakan email atau username Anda</p>
      </div>

      <% if (typeof error !== 'undefined' && error) {%>
        <div role="alert" class="w-full bg-rose-50 border border-rose-100 text-rose-700 px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3">
          <div class="w-8 h-8 rounded-[12px] bg-rose-100 flex items-center justify-center shrink-0">
            <i class="fas fa-exclamation-circle text-xs"></i>
          </div>
          <p><%= error%></p>
        </div>
      <% }%>

      <% if (typeof success !== 'undefined' && success) {%>
        <div role="status" class="w-full bg-emerald-50 border border-emerald-100 text-emerald-700 px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3">
          <div class="w-8 h-8 rounded-[12px] bg-emerald-100 flex items-center justify-center shrink-0">
            <i class="fas fa-check-circle text-xs"></i>
          </div>
          <p><%= success%></p>
        </div>
      <% }%>

      <form method="POST" action="/login" class="w-full flex flex-col gap-4">

        <div>
          <label for="loginInput" class="block text-xs font-bold text-slate-700 mb-2 px-1">Email atau Username</label>
          <div class="flex items-center bg-slate-50/80 border border-white rounded-[16px] p-1.5 transition-all duration-300 focus-within:border-finance-blue focus-within:ring-2 focus-within:ring-slate-200 focus-within:bg-white">
            <div class="pl-3 text-slate-400 flex items-center" aria-hidden="true">
              <i class="fas fa-user text-xs"></i>
            </div>
            <input id="loginInput" name="login" type="text" placeholder="username atau email" aria-label="Email atau username"
                   class="flex-1 bg-transparent px-2 py-3 text-[13px] font-semibold text-slate-800 outline-none w-full placeholder:text-xs placeholder:font-medium placeholder:text-slate-400"
                   required autocomplete="username"
                   oninput="this.value = this.value.toLowerCase()">
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2 px-1">
            <label for="passwordInput" class="block text-xs font-bold text-slate-700">Password</label>
          </div>
          <div class="flex items-center bg-slate-50/80 border border-white rounded-[16px] p-1.5 transition-all duration-300 focus-within:border-finance-blue focus-within:ring-2 focus-within:ring-slate-200 focus-within:bg-white">
            <div class="pl-3 text-slate-400 flex items-center" aria-hidden="true">
              <i class="fas fa-lock text-xs"></i>
            </div>
            <input id="passwordInput" name="password" type="password" placeholder="••••••••" aria-label="Password"
                   class="flex-1 bg-transparent px-2 py-3 text-[13px] font-semibold text-slate-800 outline-none w-full placeholder:text-xs placeholder:font-medium placeholder:text-slate-400"
                   required autocomplete="current-password">
            <button type="button" id="passwordToggleBtn" onclick="togglePassword()" aria-label="Tampilkan password" aria-pressed="false" class="w-11 h-11 text-slate-500 hover:text-slate-700 transition-all flex items-center justify-center shrink-0 mr-1 rounded-[10px]">
              <i id="toggleIcon" class="far fa-eye text-xs" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="group bg-finance-blue text-white w-full py-4 min-h-[52px] rounded-[16px] text-sm font-bold shadow-soft-lg transition-all duration-300 ease-spring hover:bg-finance-blue-deep active:scale-[0.99] flex items-center justify-center gap-2.5 mt-2">
          Masuk
          <i class="fas fa-arrow-right text-xs transition-transform duration-700 ease-spring group-hover:translate-x-0.5"></i>
        </button>
      </form>

      <p class="mt-7 text-center text-[13px] font-medium text-slate-600">
        Belum punya akun?
        <a href="/register" class="inline-flex items-center min-h-[44px] text-finance-blue font-bold hover:underline transition-colors">Daftar sekarang</a>
      </p>
    </div>
  </div>
</div>

<script>
function togglePassword(){
  var passwordInput = document.getElementById("passwordInput");
  var toggleIcon = document.getElementById("toggleIcon");
  var btn = document.getElementById("passwordToggleBtn");
  var show = passwordInput.type === "password";
  passwordInput.type = show ? "text" : "password";
  toggleIcon.classList.toggle("fa-eye", !show);
  toggleIcon.classList.toggle("fa-eye-slash", show);
  if (btn) {
    btn.setAttribute("aria-pressed", String(show));
    btn.setAttribute("aria-label", show ? "Sembunyikan password" : "Tampilkan password");
    passwordInput.focus();
  }
}
</script>

<%- include('../partials/footer')%>
