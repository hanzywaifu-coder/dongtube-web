<%- include('../partials/header', { title: '' })%>

<div class="page-wrap max-w-[480px] md:max-w-6xl mx-auto">

  <section class="reveal relative overflow-hidden rounded-[28px] shadow-soft-lg text-white overflow-hidden mt-2" style="background:var(--nav-grad);">
    <div class="absolute inset-0 opacity-25 pointer-events-none" style="background-image:radial-gradient(circle at 100% 0%,#fff 0%,transparent 45%);"></div>
    <div class="relative z-10 px-6 sm:px-10 py-9 sm:py-14">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 ring-1 ring-white/25 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.08em]">
        <img src="/img/logo.jpg" alt="" width="18" height="18" class="w-[18px] h-[18px] rounded-full object-cover"> Verifikasi SMS instan
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.08] max-w-2xl">
        Terima kode OTP untuk verifikasi berbagai platform pilihanmu
      </h1>
      <p class="mt-4 text-[13px] sm:text-[15px] font-medium text-white/80 max-w-xl leading-relaxed">
        Sewa nomor virtual untuk verifikasi ratusan platform. Pesan nomor, tunggu SMS, salin kode.
        Tidak perlu membagikan nomor pribadi Anda.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <% if (user) { %>
          <a href="/otp" class="min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white text-finance-blue text-[13px] font-bold shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300 ease-spring">
            <i class="fa-solid fa-mobile-screen-button text-xs"></i> Pesan Nomor Sekarang
          </a>
          <a href="/deposit" class="min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white/15 ring-1 ring-white/30 text-white text-[13px] font-bold hover:bg-white/25 transition-all">
            <i class="fa-solid fa-wallet text-xs"></i> Isi Saldo
          </a>
        <% } else { %>
          <a href="/register" class="min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white text-finance-blue text-[13px] font-bold shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300 ease-spring">
            <i class="fa-solid fa-user-plus text-xs"></i> Daftar Gratis
          </a>
          <a href="/login" class="min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white/15 ring-1 ring-white/30 text-white text-[13px] font-bold hover:bg-white/25 transition-all">
            <i class="fa-solid fa-right-to-bracket text-xs"></i> Masuk
          </a>
        <% } %>
      </div>

      <div class="mt-9 grid grid-cols-3 gap-3 sm:gap-4 max-w-lg">
        <div class="rounded-[18px] bg-white/12 ring-1 ring-white/20 px-4 py-3.5">
          <p class="text-xl sm:text-2xl font-extrabold">240+</p>
          <p class="text-[11px] font-semibold text-white/75 mt-0.5">Negara tersedia</p>
        </div>
        <div class="rounded-[18px] bg-white/12 ring-1 ring-white/20 px-4 py-3.5">
          <p class="text-xl sm:text-2xl font-extrabold">400+</p>
          <p class="text-[11px] font-semibold text-white/75 mt-0.5">Layanan platform</p>
        </div>
        <div class="rounded-[18px] bg-white/12 ring-1 ring-white/20 px-4 py-3.5">
          <p class="text-xl sm:text-2xl font-extrabold">24/7</p>
          <p class="text-[11px] font-semibold text-white/75 mt-0.5">Pemesanan otomatis</p>
        </div>
      </div>
    </div>
  </section>

  <section class="reveal mt-10">
    <div class="flex items-center gap-3 mb-5">
      <span class="w-9 h-9 rounded-[12px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-layer-group text-sm"></i></span>
      <h2 class="text-lg sm:text-xl font-extrabold tracking-tight ink">Kenapa Dongtube OTP?</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% [
        ['fa-bolt', 'Instan & otomatis', 'Kode OTP tampil langsung di dashboard. Pesanan aktif dipantau otomatis tanpa perlu muat ulang halaman.'],
        ['fa-tags', 'Harga transparan', 'Harga tiap negara dan layanan tertera jelas sebelum pesan. Tidak ada biaya tersembunyi di akhir.'],
        ['fa-qrcode', 'Isi saldo QRIS', 'Top up lewat QRIS kapan saja. Saldo masuk otomatis begitu pembayaran terkonfirmasi.'],
        ['fa-rotate-left', 'Refund otomatis', 'Nomor gagal menerima SMS dalam masa sewa? Saldo dikembalikan otomatis oleh sistem.'],
      ].forEach(([icon, judul, isi]) => { %>
        <div class="bg-white rounded-[22px] shadow-soft border border-white p-5 hover:-translate-y-1 transition-all duration-300 ease-spring">
          <div class="w-11 h-11 rounded-[15px] bg-pastel-blue text-finance-blue flex items-center justify-center mb-3.5"><i class="fas <%= icon %> text-sm"></i></div>
          <h3 class="text-[14px] font-bold ink mb-1.5"><%= judul %></h3>
          <p class="text-[12px] leading-relaxed" style="color:var(--text-2)"><%= isi %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="reveal mt-10">
    <div class="flex items-center gap-3 mb-5">
      <span class="w-9 h-9 rounded-[12px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-list-ol text-sm"></i></span>
      <h2 class="text-lg sm:text-xl font-extrabold tracking-tight ink">Cara kerjanya</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <% [
        ['01', 'Buat akun', 'Daftar gratis dengan username dan email, lalu masuk ke dashboard OTP.'],
        ['02', 'Pilih nomor', 'Tentukan negara, layanan, harga, dan jumlah nomor yang diinginkan.'],
        ['03', 'Salin kode', 'Nomor langsung aktif, SMS masuk, salin kode OTP dari layar.'],
      ].forEach(([no, judul, isi]) => { %>
        <div class="bg-white rounded-[22px] shadow-soft border border-white p-6">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-finance-blue text-white text-[12px] font-extrabold mb-3"><%= no %></span>
          <h3 class="text-[14px] font-bold ink mb-1.5"><%= judul %></h3>
          <p class="text-[12px] leading-relaxed" style="color:var(--text-2)"><%= isi %></p>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="reveal mt-10">
    <div class="bg-white rounded-[24px] shadow-soft border border-white p-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-5">
        <div>
          <h2 class="text-[15px] font-extrabold ink">Didukung ratusan platform</h2>
          <p class="text-[12px] mt-1" style="color:var(--text-3)">Dari media sosial sampai dompet digital dan marketplace.</p>
        </div>
        <a href="/register" class="inline-flex items-center gap-2 text-[12px] font-bold text-finance-blue hover:underline">Mulai sekarang <i class="fas fa-arrow-right text-[10px]"></i></a>
      </div>
      <div class="flex flex-wrap gap-2.5">
        <% ['whatsapp','telegram','instagram','tiktok','google','facebook','discord','twitter','openai','netflix','spotify','shopee'].forEach((slug) => { %>
          <span class="inline-flex items-center gap-2 rounded-[14px] bg-slate-50 border border-slate-100 px-3.5 py-2.5 text-[11px] font-bold text-slate-700 capitalize">
            <img src="/img/otp-services/<%= slug %>.svg" alt="<%= slug %>" loading="lazy" decoding="async" class="w-4 h-4 opacity-80"> <%= slug %>
          </span>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="reveal mt-10 mb-4 relative overflow-hidden rounded-[26px] shadow-soft-lg text-white overflow-hidden" style="background:var(--nav-grad);">
    <div class="absolute inset-0 opacity-25 pointer-events-none" style="background-image:radial-gradient(circle at 0% 100%,#fff 0%,transparent 45%);"></div>
    <div class="relative z-10 px-6 sm:px-9 py-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
      <div>
        <h2 class="text-lg sm:text-xl font-extrabold tracking-tight">Siap verifikasi tanpa nomor pribadi?</h2>
        <p class="text-[12px] sm:text-[13px] font-medium text-white/80 mt-1.5">Buat akun, isi saldo QRIS, dan pesan nomor pertama Anda hari ini.</p>
      </div>
      <% if (user) { %>
        <a href="/otp" class="shrink-0 min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white text-finance-blue text-[13px] font-bold shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300 ease-spring">Buka Dashboard <i class="fas fa-arrow-right text-xs"></i></a>
      <% } else { %>
        <a href="/register" class="shrink-0 min-h-[48px] inline-flex items-center gap-2 px-6 rounded-[16px] bg-white text-finance-blue text-[13px] font-bold shadow-soft-lg hover:-translate-y-0.5 transition-all duration-300 ease-spring">Daftar Gratis <i class="fas fa-arrow-right text-xs"></i></a>
      <% } %>
    </div>
  </section>

</div>

<%- include('../partials/footer')%>
