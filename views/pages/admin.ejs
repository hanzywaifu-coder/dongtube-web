<%- include('../partials/header', { title: 'Admin' })%>

<%
  const rp = (v) => 'Rp ' + Number(v || 0).toLocaleString('id-ID');
  const statusLabel = { submitting:'Mengirim', active:'Menunggu OTP', received:'OTP diterima', finished:'Selesai', expired:'Berakhir', cancelled:'Dibatalkan', failed:'Gagal' };
  const statusBadge = { received:'bg-emerald-50 text-emerald-600', finished:'bg-emerald-50 text-emerald-600', active:'bg-blue-50 text-blue-700', submitting:'bg-blue-50 text-blue-700', cancelled:'bg-slate-100 text-slate-600', expired:'bg-slate-100 text-slate-600', failed:'bg-red-50 text-red-600' };
%>

<div class="page-wrap max-w-[480px] md:max-w-6xl mx-auto">
  <%- include('../partials/page_hero', { heroTitle:'Panel Admin', heroSubtitle:'Pantau keuntungan, kelola user, markup, dan pesanan OTP.', heroIcon:'fa-gauge-high' })%>

  <% if (success) {%>
  <div class="bg-emerald-50 border border-emerald-100 text-finance-green px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3 shadow-sm">
    <div class="w-8 h-8 rounded-[12px] bg-emerald-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
    <p><%= success%></p>
  </div>
  <% }%>
  <% if (error) {%>
  <div class="bg-rose-50 border border-rose-100 text-finance-red px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3 shadow-sm">
    <div class="w-8 h-8 rounded-[12px] bg-rose-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
    <p><%= error%></p>
  </div>
  <% }%>

  <!-- Ringkasan keuntungan -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6" aria-label="Ringkasan keuntungan">
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-5">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-9 h-9 rounded-[12px] bg-emerald-50 text-emerald-600 flex items-center justify-center"><i class="fas fa-sack-dollar text-xs"></i></div>
        <p class="text-[11px] font-bold uppercase tracking-[0.05em]" style="color:var(--text-3)">Keuntungan</p>
      </div>
      <p class="t-display-sm text-emerald-600"><%= rp(stat.profit) %></p>
      <p class="text-[11px] mt-1.5" style="color:var(--text-3)">dari <%= stat.orders %> pesanan</p>
    </div>
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-5">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-9 h-9 rounded-[12px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-calendar-days text-xs"></i></div>
        <p class="text-[11px] font-bold uppercase tracking-[0.05em]" style="color:var(--text-3)">Bulan Ini</p>
      </div>
      <p class="t-display-sm text-finance-blue"><%= rp(statMonth.profit) %></p>
      <p class="text-[11px] mt-1.5" style="color:var(--text-3)"><%= statMonth.orders %> pesanan bulan ini</p>
    </div>
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-5">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-9 h-9 rounded-[12px] bg-amber-50 text-amber-600 flex items-center justify-center"><i class="fas fa-arrow-trend-up text-xs"></i></div>
        <p class="text-[11px] font-bold uppercase tracking-[0.05em]" style="color:var(--text-3)">Pendapatan</p>
      </div>
      <p class="t-display-sm ink"><%= rp(stat.revenue) %></p>
      <p class="text-[11px] mt-1.5" style="color:var(--text-3)">modal <%= rp(stat.cost) %> - refund <%= rp(stat.refunded) %></p>
    </div>
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-5">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-9 h-9 rounded-[12px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-wallet text-xs"></i></div>
        <p class="text-[11px] font-bold uppercase tracking-[0.05em]" style="color:var(--text-3)">Saldo User</p>
      </div>
      <p class="t-display-sm ink"><%= rp(balanceStat.total) %></p>
      <p class="text-[11px] mt-1.5" style="color:var(--text-3)"><%= balanceStat.n %> akun terdaftar</p>
    </div>
  </section>

  <div class="grid gap-4 md:grid-cols-2 mb-8">
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-11 h-11 rounded-[15px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-percent text-sm"></i></div>
        <div>
          <h2 class="text-sm font-bold ink">Markup Global (%)</h2>
          <p class="text-[11px]" style="color:var(--text-3)">Diterapkan ke semua user</p>
        </div>
      </div>
      <form method="post" action="/admin/markup" class="flex gap-2.5 flex-wrap">
        <input type="number" name="markup" value="<%= markup %>" min="0" step="0.1" aria-label="Markup global"
               class="flex-1 min-w-[120px] bg-slate-50 border border-white rounded-[14px] px-4 min-h-[44px] text-sm font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue">
        <button type="submit" class="bg-finance-blue text-white px-5 min-h-[44px] rounded-[14px] text-xs font-bold shadow-soft hover:-translate-y-0.5 transition-all">Simpan</button>
      </form>
    </div>

    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-11 h-11 rounded-[15px] bg-pastel-blue text-finance-blue flex items-center justify-center"><i class="fas fa-layer-group text-sm"></i></div>
        <div>
          <h2 class="text-sm font-bold ink">Status Pesanan</h2>
          <p class="text-[11px]" style="color:var(--text-3)">Jumlah & keuntungan per status</p>
        </div>
      </div>
      <% if (!statusStat.length) { %>
        <p class="text-xs font-semibold" style="color:var(--text-3)">Belum ada pesanan.</p>
      <% } %>
      <div class="flex flex-col gap-2">
        <% statusStat.forEach(st => { %>
          <div class="flex items-center justify-between gap-3 text-xs">
            <span class="inline-flex px-2 py-0.5 rounded-md text-[10px] font-bold <%= statusBadge[st.status] || 'bg-slate-100 text-slate-600' %>"><%= statusLabel[st.status] || st.status %></span>
            <span class="font-semibold" style="color:var(--text-2)"><%= st.n %> pesanan</span>
            <span class="font-bold text-emerald-600 min-w-[90px] text-right"><%= rp(st.profit) %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- User + aksi -->
  <section class="reveal mb-8">
    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
      <h2 class="text-[15px] font-extrabold ink flex items-center gap-2"><i class="fas fa-users text-finance-blue"></i> Users <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500"><%= users.length %></span></h2>
      <input id="userSearch" type="search" placeholder="Cari nama atau email..." aria-label="Cari user" oninput="filterUsers()"
             class="bg-slate-50 border border-white rounded-[14px] px-4 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue w-full sm:w-64">
    </div>
    <div class="bg-white rounded-[24px] shadow-soft border border-white overflow-x-auto custom-scroll">
      <table id="userTable" class="w-full text-left text-xs border-collapse min-w-[680px]">
        <thead>
          <tr class="text-[10px] uppercase tracking-[0.06em]" style="color:var(--text-3)">
            <th class="px-4 py-3 font-bold">Nama</th>
            <th class="px-4 py-3 font-bold">Email</th>
            <th class="px-4 py-3 font-bold text-right">Saldo</th>
            <th class="px-4 py-3 font-bold">Role</th>
            <th class="px-4 py-3 font-bold text-right">Markup</th>
            <th class="px-4 py-3 font-bold text-right">Dibuat</th>
            <th class="px-4 py-3 font-bold text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!users.length) { %>
            <tr><td colspan="7" class="px-4 py-10 text-center font-semibold" style="color:var(--text-3)">Belum ada user</td></tr>
          <% } %>
          <% users.forEach(u => { %>
            <tr class="border-t border-slate-50 hover:bg-slate-50/70 transition-colors" data-search="<%= (u.name + ' ' + u.email).toLowerCase() %>">
              <td class="px-4 py-3 font-semibold text-slate-800"><%= u.name %></td>
              <td class="px-4 py-3" style="color:var(--text-2)"><%= u.email %></td>
              <td class="px-4 py-3 text-right font-bold text-slate-800"><%= rp(u.balance) %></td>
              <td class="px-4 py-3">
                <span class="inline-flex px-2 py-0.5 rounded-md text-[10px] font-bold <%= u.role === 'admin' ? 'bg-pastel-blue text-finance-blue' : 'bg-slate-100 text-slate-600' %>"><%= u.role %></span>
              </td>
              <td class="px-4 py-3 text-right font-semibold text-slate-700"><%= u.markup_percent %>%</td>
              <td class="px-4 py-3 text-right font-mono" style="color:var(--text-3)"><%= new Date((u.created_at || 0) * 1000).toLocaleDateString('id-ID') %></td>
              <td class="px-4 py-3 text-right whitespace-nowrap">
                <button type="button" onclick="openUserModal(this)"
                        data-id="<%= u.id %>" data-name="<%= u.name %>" data-email="<%= u.email %>"
                        data-role="<%= u.role %>" data-markup="<%= u.markup_percent %>" data-balance="<%= Number(u.balance || 0) %>"
                        class="bg-pastel-blue text-finance-blue hover:bg-finance-blue hover:text-white px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">
                  <i class="fas fa-pen"></i> Edit
                </button>
                <button type="button" onclick="hapusUser(<%= u.id %>, '<%= u.name %>')"
                        class="ml-1.5 bg-rose-50 text-finance-red hover:bg-finance-red hover:text-white px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">
                  <i class="fas fa-trash"></i> Hapus
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="reveal mb-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-[15px] font-extrabold ink flex items-center gap-2"><i class="fas fa-receipt text-finance-blue"></i> Pesanan Terbaru</h2>
      <span class="text-[11px] font-semibold" style="color:var(--text-3)">50 terakhir</span>
    </div>
    <div class="bg-white rounded-[24px] shadow-soft border border-white overflow-x-auto custom-scroll">
      <table class="w-full text-left text-xs border-collapse min-w-[760px]">
        <thead>
          <tr class="text-[10px] uppercase tracking-[0.06em]" style="color:var(--text-3)">
            <th class="px-4 py-3 font-bold">#</th>
            <th class="px-4 py-3 font-bold">User</th>
            <th class="px-4 py-3 font-bold">Layanan</th>
            <th class="px-4 py-3 font-bold">Negara</th>
            <th class="px-4 py-3 font-bold text-right">Tagihan</th>
            <th class="px-4 py-3 font-bold text-right">Profit</th>
            <th class="px-4 py-3 font-bold">Status</th>
            <th class="px-4 py-3 font-bold">Nomor / OTP</th>
          </tr>
        </thead>
        <tbody>
          <% if (!orders.length) { %>
            <tr><td colspan="8" class="px-4 py-10 text-center font-semibold" style="color:var(--text-3)">Belum ada pesanan</td></tr>
          <% } %>
          <% orders.forEach(o => { %>
            <tr class="border-t border-slate-50 hover:bg-slate-50/70 transition-colors">
              <td class="px-4 py-3 font-mono font-bold text-slate-700"><%= o.id %></td>
              <td class="px-4 py-3" style="color:var(--text-2)"><%= (users.find(x => x.id === o.user_id) || {}).name || ('#' + o.user_id) %></td>
              <td class="px-4 py-3 font-semibold text-slate-800"><%= o.service_name %></td>
              <td class="px-4 py-3" style="color:var(--text-2)"><%= o.country_id %></td>
              <td class="px-4 py-3 text-right font-semibold text-slate-800"><%= rp(o.charged_price) %></td>
              <td class="px-4 py-3 text-right font-bold <%= Number(o.profit) < 0 ? 'text-finance-red' : 'text-emerald-600' %>"><%= rp(o.profit) %></td>
              <td class="px-4 py-3"><span class="inline-flex px-2 py-0.5 rounded-md text-[10px] font-bold <%= statusBadge[o.status] || 'bg-slate-100 text-slate-600' %>"><%= statusLabel[o.status] || o.status %></span></td>
              <td class="px-4 py-3 font-mono" style="color:var(--text-2)"><%= o.phone || '-' %> <b class="text-finance-blue"><%= o.otp_code || '' %></b></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<!-- Modal edit user -->
<div id="userModal" class="fixed inset-0 z-[110] hidden p-4" role="dialog" aria-modal="true" aria-labelledby="userModalTitle">
  <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" onclick="closeUserModal()"></div>
  <div class="relative bg-white rounded-[28px] shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto p-6 mx-auto my-auto">
    <div class="flex items-center justify-between mb-5">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-11 h-11 rounded-[15px] bg-gradient-to-br from-finance-blue to-finance-blue-deep text-white flex items-center justify-center shrink-0"><i class="fas fa-user-pen text-sm"></i></div>
        <div class="min-w-0">
          <h2 id="userModalTitle" class="text-[15px] font-bold ink">Edit User</h2>
          <p id="userModalSub" class="text-[11px] truncate" style="color:var(--text-3)"></p>
        </div>
      </div>
      <button type="button" onclick="closeUserModal()" aria-label="Tutup" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center shrink-0"><i class="fas fa-xmark text-slate-500"></i></button>
    </div>

    <form id="userForm" method="POST" action="/admin/users/0/edit" class="flex flex-col gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2 px-1" for="uName">Nama</label>
        <input id="uName" name="name" type="text" maxlength="20" required
               class="w-full bg-slate-50 border border-white rounded-[14px] px-4 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue">
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-2 px-1" for="uEmail">Email</label>
        <input id="uEmail" name="email" type="email" required
               class="w-full bg-slate-50 border border-white rounded-[14px] px-4 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-2 px-1" for="uRole">Role</label>
          <select id="uRole" name="role"
                  class="w-full bg-slate-50 border border-white rounded-[14px] px-3 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue">
            <option value="user">user</option>
            <option value="admin">admin</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-2 px-1" for="uMarkup">Markup %</label>
          <input id="uMarkup" name="markup_percent" type="number" min="0" step="0.1"
                 class="w-full bg-slate-50 border border-white rounded-[14px] px-4 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue focus:ring-1 focus:ring-finance-blue">
        </div>
      </div>

      <div class="bg-slate-50 border border-white rounded-[16px] p-4">
        <div class="flex items-center justify-between mb-3">
          <p class="text-xs font-semibold text-slate-700">Isi / ubah saldo</p>
          <span class="text-[11px] font-bold text-finance-blue">opsional</span>
        </div>
        <div class="flex gap-2">
          <select id="uOp" name="balance_op" aria-label="Operasi saldo"
                  class="bg-white border border-white rounded-[12px] px-3 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue shrink-0">
            <option value="add">Tambah</option>
            <option value="sub">Kurang</option>
            <option value="set">Setel</option>
          </select>
          <input id="uAmt" name="balance_amount" type="number" min="0" step="1" placeholder="Nominal"
                 class="flex-1 min-w-0 bg-white border border-white rounded-[12px] px-4 min-h-[44px] text-xs font-semibold text-slate-800 outline-none focus:border-finance-blue">
        </div>
        <div class="flex flex-wrap gap-2 mt-3">
          <button type="button" onclick="setBalance('add', 10000)" class="bg-white border border-white text-slate-700 hover:text-finance-blue hover:border-finance-blue px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">+10.000</button>
          <button type="button" onclick="setBalance('add', 50000)" class="bg-white border border-white text-slate-700 hover:text-finance-blue hover:border-finance-blue px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">+50.000</button>
          <button type="button" onclick="setBalance('add', 100000)" class="bg-white border border-white text-slate-700 hover:text-finance-blue hover:border-finance-blue px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">+100.000</button>
          <button type="button" onclick="setBalance('sub', 10000)" class="bg-white border border-white text-slate-700 hover:text-finance-red hover:border-finance-red px-3 min-h-[36px] rounded-[10px] text-[11px] font-bold transition-colors">−10.000</button>
        </div>
        <p class="text-[10px] mt-2.5" style="color:var(--text-3)">Biarkan kosong kalau tidak mengubah saldo.</p>
      </div>

      <div class="flex gap-3">
        <button type="button" onclick="closeUserModal()" class="flex-1 bg-slate-50 border border-white text-slate-700 hover:bg-slate-100 min-h-[46px] rounded-[16px] text-xs font-bold transition-colors">Batal</button>
        <button type="submit" class="flex-1 bg-finance-blue text-white min-h-[46px] rounded-[16px] text-xs font-bold shadow-soft hover:-translate-y-0.5 transition-all"><i class="fas fa-save"></i> Simpan</button>
      </div>
    </form>
  </div>
</div>

<form id="delForm" method="POST" action="/admin/users/0/delete" class="hidden"></form>

<script>
function openUserModal(btn) {
  var f = document.getElementById('userForm');
  f.action = '/admin/users/' + btn.dataset.id + '/edit';
  document.getElementById('uName').value = btn.dataset.name;
  document.getElementById('uEmail').value = btn.dataset.email;
  document.getElementById('uRole').value = btn.dataset.role;
  document.getElementById('uMarkup').value = btn.dataset.markup;
  document.getElementById('uOp').value = 'add';
  document.getElementById('uAmt').value = '';
  document.getElementById('userModalSub').textContent = btn.dataset.email + ' - saldo Rp ' + Number(btn.dataset.balance || 0).toLocaleString('id-ID');
  var m = document.getElementById('userModal');
  m.classList.remove('hidden');
  m.style.display = 'flex';
}
function closeUserModal() {
  var m = document.getElementById('userModal');
  m.style.display = 'none';
  m.classList.add('hidden');
}
function setBalance(op, amt) {
  document.getElementById('uOp').value = op;
  document.getElementById('uAmt').value = amt;
}
function filterUsers() {
  var q = document.getElementById('userSearch').value.toLowerCase();
  document.querySelectorAll('#userTable tbody tr[data-search]').forEach(function (tr) {
    tr.style.display = (!q || tr.dataset.search.indexOf(q) !== -1) ? '' : 'none';
  });
}
function hapusUser(id, nama) {
  if (confirm('Hapus user "' + nama + '" beserta semua pesanan dan depositnya?')) {
    var f = document.getElementById('delForm');
    f.action = '/admin/users/' + id + '/delete';
    f.submit();
  }
}
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeUserModal(); });
</script>
<% if (editId) { %>
<script>
(function () {
  var b = document.querySelector('#userTable button[data-id="<%= editId %>"]');
  if (b) openUserModal(b);
})();
</script>
<% } %>

<%- include('../partials/footer')%>
