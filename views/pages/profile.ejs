<%- include('../partials/header', { title: 'Profil' })%>

<div class="page-wrap max-w-[480px] md:max-w-3xl mx-auto">
  <%- include('../partials/page_hero', { heroTitle:'Profil Akun', heroSubtitle:'Perbarui email dan password untuk masuk ke akun.', heroIcon:'fa-user' })%>

  <% if (typeof error !== 'undefined' && error) {%>
    <div class="bg-rose-50 border border-rose-100 text-finance-red px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3">
      <div class="w-8 h-8 rounded-[12px] bg-rose-100 flex items-center justify-center shrink-0">
        <i class="fas fa-exclamation-circle text-xs"></i>
      </div>
      <p><%= error%></p>
    </div>
  <% }%>
  <% if (typeof success !== 'undefined' && success) {%>
    <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 px-5 py-4 rounded-[20px] mb-6 text-xs font-semibold flex items-center gap-3">
      <div class="w-8 h-8 rounded-[12px] bg-emerald-100 flex items-center justify-center shrink-0">
        <i class="fas fa-check-circle text-xs"></i>
      </div>
      <p><%= success%></p>
    </div>
  <% }%>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-6">
      <div class="flex items-center gap-3.5 mb-5 pb-4 border-b border-slate-100">
        <div class="w-12 h-12 rounded-[16px] bg-gradient-to-br from-finance-blue to-finance-blue-deep text-white flex items-center justify-center shadow-soft shrink-0">
          <i class="fas fa-id-card text-sm"></i>
        </div>
        <div class="min-w-0">
          <h2 class="text-base font-bold text-slate-900">Informasi Akun</h2>
          <p class="text-[11px] font-medium text-slate-400">Email dipakai untuk masuk ke akun.</p>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-2 px-1">Nama</label>
          <div class="flex items-center bg-slate-50 border border-white rounded-[16px] p-1.5">
            <div class="pl-3 text-slate-400 flex items-center"><i class="fas fa-user text-xs"></i></div>
            <input type="text" value="<%= user.name || '-' %>" aria-label="Nama" readonly
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full cursor-not-allowed">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-2 px-1">Peran & Saldo</label>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="inline-flex items-center gap-1.5 bg-pastel-blue text-finance-blue text-[11px] font-bold px-3 py-2 rounded-full">
              <i class="fas fa-shield-halved text-[10px]"></i> <%= user.role === 'admin' ? 'Admin' : 'Member' %>
            </span>
            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-[11px] font-bold px-3 py-2 rounded-full">
              <i class="fas fa-wallet text-[10px]"></i> Rp <%= Number(user.balance || 0).toLocaleString('id-ID') %>
            </span>
          </div>
        </div>

        <form method="POST" action="/profile">
          <div>
            <label for="emailProfile" class="block text-xs font-semibold text-slate-700 mb-2 px-1">Alamat Email</label>
            <div class="flex items-center bg-slate-50 border border-white rounded-[16px] p-1.5 transition-all focus-within:border-finance-blue focus-within:ring-1 focus-within:ring-finance-blue">
              <div class="pl-3 text-slate-400 flex items-center"><i class="far fa-envelope text-xs"></i></div>
              <input id="emailProfile" name="email" type="email" value="<%= user.email %>" aria-label="Alamat email"
                     class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full" required>
            </div>
          </div>
          <button type="submit" class="group bg-finance-blue text-white w-full py-3.5 rounded-[16px] text-sm font-bold shadow-soft transition-all duration-500 hover:-translate-y-0.5 active:scale-[0.99] flex items-center justify-center gap-2.5 mt-4">
            Simpan Perubahan <i class="fas fa-check text-xs"></i>
          </button>
        </form>
      </div>
    </div>

    <div class="reveal bg-white rounded-[24px] shadow-soft border border-white p-6">
      <div class="flex items-center gap-3.5 mb-5 pb-4 border-b border-slate-100">
        <div class="w-12 h-12 rounded-[16px] bg-gradient-to-br from-finance-blue to-finance-blue-deep text-white flex items-center justify-center shadow-soft shrink-0">
          <i class="fas fa-lock text-sm"></i>
        </div>
        <div class="min-w-0">
          <h2 class="text-base font-bold text-slate-900">Ganti Password</h2>
          <p class="text-[11px] font-medium text-slate-400">Password baru minimal 6 karakter.</p>
        </div>
      </div>

      <form method="POST" action="/profile/password" class="flex flex-col gap-4" autocomplete="off">
        <div>
          <label for="currentPassword" class="block text-xs font-semibold text-slate-700 mb-2 px-1">Password Lama</label>
          <div class="flex items-center bg-slate-50 border border-white rounded-[16px] p-1.5 transition-all focus-within:border-finance-blue focus-within:ring-1 focus-within:ring-finance-blue">
            <div class="pl-3 text-slate-400 flex items-center"><i class="fas fa-key text-xs"></i></div>
            <input id="currentPassword" name="currentPassword" type="password" placeholder="••••••••" aria-label="Password lama"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full" required>
          </div>
        </div>

        <div>
          <label for="newPassword" class="block text-xs font-semibold text-slate-700 mb-2 px-1">Password Baru</label>
          <div class="flex items-center bg-slate-50 border border-white rounded-[16px] p-1.5 transition-all focus-within:border-finance-blue focus-within:ring-1 focus-within:ring-finance-blue">
            <div class="pl-3 text-slate-400 flex items-center"><i class="fas fa-lock text-xs"></i></div>
            <input id="newPassword" name="newPassword" type="password" placeholder="••••••••" aria-label="Password baru" minlength="6"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full" required>
            <button type="button" onclick="toggleField('newPassword','newPasswordIcon')" aria-label="Tampilkan password baru"
                    class="w-8 h-8 min-w-[44px] min-h-[44px] text-slate-400 hover:text-slate-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="newPasswordIcon" class="far fa-eye text-xs"></i>
            </button>
          </div>
        </div>

        <div>
          <label for="confirmPassword" class="block text-xs font-semibold text-slate-700 mb-2 px-1">Ulangi Password Baru</label>
          <div class="flex items-center bg-slate-50 border border-white rounded-[16px] p-1.5 transition-all focus-within:border-finance-blue focus-within:ring-1 focus-within:ring-finance-blue">
            <div class="pl-3 text-slate-400 flex items-center"><i class="fas fa-lock text-xs"></i></div>
            <input id="confirmPassword" name="confirmPassword" type="password" placeholder="••••••••" aria-label="Ulangi password baru" minlength="6"
                   class="flex-1 bg-transparent px-2 py-2.5 text-[13px] font-semibold text-slate-800 outline-none w-full" required>
            <button type="button" onclick="toggleField('confirmPassword','confirmPasswordIcon')" aria-label="Tampilkan ulangi password"
                    class="w-8 h-8 min-w-[44px] min-h-[44px] text-slate-400 hover:text-slate-600 transition-all flex items-center justify-center shrink-0 mr-1">
              <i id="confirmPasswordIcon" class="far fa-eye text-xs"></i>
            </button>
          </div>
        </div>

        <p id="matchHint" class="text-[11px] font-semibold px-1 min-h-[16px]"></p>

        <button type="submit" id="passwordBtn" class="group bg-finance-blue text-white w-full py-3.5 rounded-[16px] text-sm font-bold shadow-soft transition-all duration-500 hover:-translate-y-0.5 active:scale-[0.99] flex items-center justify-center gap-2.5 disabled:opacity-60 disabled:cursor-not-allowed" disabled>
          Ganti Password <i class="fas fa-key text-xs"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  function toggleField(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }

  const newPassword = document.getElementById('newPassword');
  const confirmPassword = document.getElementById('confirmPassword');
  const matchHint = document.getElementById('matchHint');
  const passwordBtn = document.getElementById('passwordBtn');

  function checkMatch() {
    const next = newPassword.value;
    const confirm = confirmPassword.value;
    if (!next && !confirm) {
      matchHint.textContent = '';
      passwordBtn.disabled = true;
      return;
    }
    if (next.length > 0 && next.length < 6) {
      matchHint.innerHTML = '<span class="text-rose-500">Password baru minimal 6 karakter.</span>';
      passwordBtn.disabled = true;
      return;
    }
    if (confirm && next !== confirm) {
      matchHint.innerHTML = '<span class="text-rose-500">Konfirmasi password belum sama.</span>';
      passwordBtn.disabled = true;
      return;
    }
    matchHint.innerHTML = next ? '<span class="text-emerald-600">Password cocok.</span>' : '';
    passwordBtn.disabled = !(next && confirm && next === confirm && next.length >= 6);
  }
  newPassword.addEventListener('input', checkMatch);
  confirmPassword.addEventListener('input', checkMatch);
</script>

<%- include('../partials/footer')%>
